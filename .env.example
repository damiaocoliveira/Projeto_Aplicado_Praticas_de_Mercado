# Arquivo de exemplo para configuração de variáveis de ambiente.
# NUNCA insira credenciais de produção ou chaves reais neste arquivo.
# Copie este arquivo para .env no ambiente local e configure os valores seguros.

# Chave secreta da aplicação Flask (deve ser uma string aleatória forte com 32+ bytes)
SECRET_KEY=sua_chave_secreta_super_aleatoria_e_segura_aqui

# Modo de execução: development ou production
FLASK_ENV=development

# Porta de execução da aplicação
PORT=5000
